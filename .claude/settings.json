{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/telegram-notify.mjs\" stop",
						"timeout": 20
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/telegram-notify.mjs\" notification",
						"timeout": 20
					}
				]
			}
		]
	}
}
