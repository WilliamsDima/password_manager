{
  "name": "password-manager",
  "version": "2.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "secrets:collect": "node scripts/collect-secrets.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pm-rules \"node --test rules-tests/*.test.mjs\""
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-firebase/app": "^27.2.0",
